<script>
(function(){
  const $ = s => document.querySelector(s);
  const $$ = s => Array.from(document.querySelectorAll(s));
  const at = (t, f) => setTimeout(f, t);

  /* ═══ 설정 — 배포 전 여기만 채우면 됩니다 ═══ */
  const CONFIG = {
    /* 네이버 클라우드 플랫폼 > Maps > Application 의 Client ID.
       비워 두면 그림 약도가 보입니다. 서비스 URL에 배포 주소(와 테스트용 localhost)를 꼭 등록하세요. */
    NAVER_MAP_KEY: '',
    ADDRESS: '서울특별시 중구 세종대로9길 41',
    LAT: 37.5617, LNG: 126.9744,          // 지오코딩 실패 시 쓰는 대략 좌표
    GALLERY: Array.from({ length: 12 }, (_, i) => 'img/gallery/' + String(i + 1).padStart(2, '0') + '.webp')
  };
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

  /* card face = exact copy of the cover's title block */
  $('#cardCore').innerHTML = $('#coverCore').innerHTML;

  /* cotton fibres: short, fine, slightly curved strands in random directions (seamless tile) */
  (function(){
    const S = 256, R = 2, c = document.createElement('canvas');
    c.width = c.height = S * R;
    const g = c.getContext('2d');
    if (!g) return;
    g.scale(R, R); g.lineCap = 'round';
    let seed = 41;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    for (let i = 0; i < 620; i++){
      const x = rnd() * S, y = rnd() * S, a = rnd() * Math.PI * 2;
      const len = 3 + Math.pow(rnd(), 1.6) * 18, bend = (rnd() - .5) * len * .5;
      const light = rnd() < .66;
      g.strokeStyle = light ? 'rgba(232,226,198,' + (.06 + rnd() * .13).toFixed(3) + ')'
                            : 'rgba(12,18,7,' + (.07 + rnd() * .14).toFixed(3) + ')';
      g.lineWidth = .45 + rnd() * .55;
      const dx = Math.cos(a) * len, dy = Math.sin(a) * len;
      const nx = -Math.sin(a) * bend, ny = Math.cos(a) * bend;
      for (const ox of [-S, 0, S]) for (const oy of [-S, 0, S]){
        const x0 = x + ox, y0 = y + oy;
        if (x0 + 24 < 0 || x0 - 24 > S || y0 + 24 < 0 || y0 - 24 > S) continue;
        g.beginPath();
        g.moveTo(x0, y0);
        g.quadraticCurveTo(x0 + dx / 2 + nx, y0 + dy / 2 + ny, x0 + dx, y0 + dy);
        g.stroke();
      }
    }
    $('#fiberImg').setAttribute('href', c.toDataURL('image/png'));
  })();

  /* wax seal: irregular poured edge */
  (function(){
    const n = 40, pts = [];
    for (let i = 0; i < n; i++){
      const a = i / n * Math.PI * 2;
      const r = 43 + 1.9*Math.sin(a*5 + .7) + 1.3*Math.sin(a*9 + 2.1) + .8*Math.sin(a*14 + .3) + (i % 7 === 3 ? 1.6 : 0);
      pts.push([50 + r*Math.cos(a), 50 + r*Math.sin(a)]);
    }
    const mid = (p, q) => ((p[0]+q[0])/2).toFixed(2) + ' ' + ((p[1]+q[1])/2).toFixed(2);
    let d = 'M' + mid(pts[n-1], pts[0]);
    for (let i = 0; i < n; i++){
      const p = pts[i], q = pts[(i+1) % n];
      d += ' Q' + p[0].toFixed(2) + ' ' + p[1].toFixed(2) + ' ' + mid(p, q);
    }
    d += 'Z';
    $('#sealBlob').setAttribute('d', d);
    $('#sealRim').setAttribute('d', d);
    $('#sealRim').setAttribute('transform', 'translate(50 50) scale(.93) translate(-50 -50)');
  })();

  /* line-drawing prep */
  $$('svg.draw').forEach(svg => {
    let i = 0;
    svg.querySelectorAll('path:not(.f), use').forEach(el => {
      if (el.tagName.toLowerCase() === 'path') el.setAttribute('pathLength', '1');
      el.style.setProperty('--dd', Math.min(i++ * 0.04, 1.6).toFixed(3) + 's');
    });
  });

  /* stagger reveal items */
  $$('.reveal').forEach(sec => {
    sec.querySelectorAll('.rv').forEach((el, i) => {
      if (!el.style.getPropertyValue('--d')) el.style.setProperty('--d', (i * 0.11).toFixed(2) + 's');
    });
  });

  /* calendar */
  (function(){
    const first = new Date(2027, 2, 1).getDay();
    let html = '';
    for (let i = 0; i < first; i++) html += '<span></span>';
    for (let d = 1; d <= 31; d++){
      const dow = (first + d - 1) % 7;
      const cls = [dow === 0 ? 'sun' : '', d === 7 ? 'wed' : ''].join(' ').trim();
      const ring = d === 7
        ? '<svg viewBox="0 0 40 40" aria-hidden="true"><path pathLength="1" d="M22 5.5 C31 6 36 13 35 21.5 C34 30 26.5 35.5 18.5 34.5 C10 33.5 4.6 26 5.6 17.5 C6.6 10 13 5 21 5.2 C24 5.4 26 6.3 27.5 7.4"/></svg>'
        : '';
      html += '<span' + (cls ? ' class="' + cls + '"' : '') + '>' + ring + d + '</span>';
    }
    $('#calGrid').innerHTML = html;
  })();

  /* countdown — 2027-03-07 15:00 KST */
  const T = Date.UTC(2027, 2, 7, 6, 0, 0);
  const pad = n => String(n).padStart(2, '0');
  function tick(){
    const now = Date.now();
    let ms = Math.max(0, T - now);
    const D = Math.floor(ms / 864e5); ms -= D * 864e5;
    const H = Math.floor(ms / 36e5);  ms -= H * 36e5;
    const M = Math.floor(ms / 6e4);   ms -= M * 6e4;
    const S = Math.floor(ms / 1e3);
    $('#cdD').textContent = pad(D);
    $('#cdH').textContent = pad(H);
    $('#cdM').textContent = pad(M);
    $('#cdS').textContent = pad(S);
    const k = new Date(now + 9 * 36e5);
    const dd = Math.round((Date.UTC(2027, 2, 7) - Date.UTC(k.getUTCFullYear(), k.getUTCMonth(), k.getUTCDate())) / 864e5);
    const badge = $('#dBadge'), msg = $('#dMsg');
    if (dd > 0){ badge.textContent = 'D-' + dd; msg.innerHTML = '용철과 주현의 결혼식이 <em>' + dd + '</em>일 남았습니다.'; }
    else if (dd === 0){ badge.textContent = 'D-DAY'; msg.innerHTML = '오늘, 두 사람이 결혼합니다.'; }
    else { badge.textContent = 'D+' + (-dd); msg.innerHTML = '두 사람이 부부가 된 지 <em>' + (-dd) + '</em>일째입니다.'; }
  }
  tick(); setInterval(tick, 1000);

  /* toast + clipboard */
  const toastEl = $('#toast');
  function toast(t){ toastEl.textContent = t; toastEl.classList.add('on'); clearTimeout(toast._t); toast._t = setTimeout(() => toastEl.classList.remove('on'), 2200); }
  async function copyText(text, msg){
    try { await navigator.clipboard.writeText(text); }
    catch(e){
      const ta = document.createElement('textarea');
      ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;top:0;opacity:0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch(_){}
      ta.remove();
    }
    toast(msg);
  }
  $('#copyBtn').addEventListener('click', () => copyText('서울특별시 중구 세종대로9길 41, 퍼시픽타워 20F 오펠리스', '주소가 복사되었어요'));
  $$('.copy').forEach(b => b.addEventListener('click', () => copyText(b.dataset.copy, '계좌번호가 복사되었어요')));

  /* map links */
  const PLACE = encodeURIComponent('오펠리스');
  $('#mapNaver').href = 'https://map.naver.com/p/search/' + PLACE;
  $('#mapKakao').href = 'https://map.kakao.com/link/search/' + PLACE;
  const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  $('#mapTmap').href = 'tmap://search?name=' + PLACE;
  $('#mapTmap').addEventListener('click', e => {
    if (!isMobile){ e.preventDefault(); toast('티맵은 모바일 앱에서 열려요'); }
  });

  /* accordions */
  $$('.acc-btn').forEach(btn => btn.addEventListener('click', () => {
    const acc = btn.parentElement, open = !acc.classList.contains('open');
    acc.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', open);
  }));

  /* RSVP sheet */
  const sheet = $('#sheet'), form = $('#rsvpForm'), done = $('#rsvpDone');
  let count = 1, lastFocus = null, savedY = 0;
  /* freeze the page where it is (no jump to top), restore on close */
  function lockScroll(){
    savedY = window.scrollY || window.pageYOffset || 0;
    document.body.style.top = (-savedY) + 'px';
    document.body.classList.add('sheet-lock');
  }
  function unlockScroll(){
    document.body.classList.remove('sheet-lock');
    document.body.style.top = '';
    const html = document.documentElement, prev = html.style.scrollBehavior;
    html.style.scrollBehavior = 'auto';
    window.scrollTo(0, savedY);
    html.style.scrollBehavior = prev;
  }
  function renderCount(){
    $('#rsvpCount').innerHTML = count + '<small>명</small>';
    $('[data-step="-1"]').disabled = count <= 1;
    $('[data-step="1"]').disabled = count >= 10;
  }
  /* shared bottom-sheet behaviour (RSVP + contact) */
  let openWrap = null;
  function openSheet(wrap){
    if (openWrap) return;
    openWrap = wrap;
    lastFocus = document.activeElement;
    lockScroll();
    wrap.classList.add('on'); wrap.setAttribute('aria-hidden', 'false');
    at(80, () => wrap.querySelector('.sheet').focus({ preventScroll: true }));
  }
  function closeSheet(){
    if (!openWrap) return;
    openWrap.classList.remove('on'); openWrap.setAttribute('aria-hidden', 'true');
    openWrap = null;
    unlockScroll();
    if (lastFocus) lastFocus.focus({ preventScroll: true });
  }
  $$('.sheet-wrap').forEach(w => w.addEventListener('click', e => { if (e.target.closest('[data-close]')) closeSheet(); }));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && openWrap) closeSheet(); });
  $('#rsvpOpen').addEventListener('click', () => {
    form.hidden = false; done.hidden = true; $('#rsvpErr').textContent = '';
    openSheet(sheet);
  });
  $('#contactOpen').addEventListener('click', () => openSheet($('#contactSheet')));

  /* add to calendar (.ics generated on the device) */
  function icsFold(line){
    const enc = new TextEncoder(), out = [];
    let cur = '', bytes = 0;
    for (const ch of line){
      const n = enc.encode(ch).length;
      if (bytes + n > 73){ out.push(cur); cur = ' '; bytes = 1; }
      cur += ch; bytes += n;
    }
    out.push(cur);
    return out.join('\r\n');
  }
  $('#icsBtn').addEventListener('click', () => {
    const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    const lines = [
      'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Yongcheol & Juhyun//Wedding Invitation//KO', 'CALSCALE:GREGORIAN', 'METHOD:PUBLISH',
      'BEGIN:VEVENT',
      'UID:20270307T0600Z-yongcheol-juhyun-wedding',
      'DTSTAMP:' + stamp,
      'DTSTART:20270307T060000Z',
      'DTEND:20270307T080000Z',
      'SUMMARY:변용철 · 최주현 결혼식',
      'LOCATION:오펠리스 라비제홀(20F)\\, 서울특별시 중구 세종대로9길 41 퍼시픽타워',
      'DESCRIPTION:2027년 3월 7일 일요일 오후 3시\\n오펠리스 라비제홀(20F)\\n서울특별시 중구 세종대로9길 41 퍼시픽타워 20F',
      'BEGIN:VALARM', 'TRIGGER:-P1D', 'ACTION:DISPLAY', 'DESCRIPTION:내일은 용철과 주현의 결혼식입니다', 'END:VALARM',
      'END:VEVENT', 'END:VCALENDAR'
    ];
    const blob = new Blob([lines.map(icsFold).join('\r\n') + '\r\n'], { type: 'text/calendar;charset=utf-8' });
    const url = URL.createObjectURL(blob), a = document.createElement('a');
    a.href = url; a.download = 'yongcheol-juhyun-wedding.ics';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 4000);
    toast('일정 파일을 내려받았어요 · 열면 캘린더에 추가돼요');
  });
  $$('.seg').forEach(seg => seg.addEventListener('click', e => {
    const b = e.target.closest('button'); if (!b) return;
    seg.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', x === b));
  }));
  $$('[data-step]').forEach(b => b.addEventListener('click', () => {
    count = Math.min(10, Math.max(1, count + Number(b.dataset.step))); renderCount();
  }));
  renderCount();
  $('#rsvpSend').addEventListener('click', () => {
    const name = $('#rsvpName').value.trim();
    if (!name){ $('#rsvpErr').textContent = '성함을 입력해 주세요.'; $('#rsvpName').focus(); return; }
    const side = $('[data-name="side"] [aria-pressed="true"]').textContent;
    const meal = $('[data-name="meal"] [aria-pressed="true"]').textContent;
    try { localStorage.setItem('rsvp-yongcheol-juhyun', JSON.stringify({ side, name, count, meal, at: new Date().toISOString() })); } catch(_){}
    const p = $('#rsvpThanks');
    p.textContent = '';
    p.append(name + '님(' + side + ', ' + count + '명)의 소중한 마음이', document.createElement('br'), '잘 전달되었어요.', document.createElement('br'), '3월의 봄날, 반갑게 맞이하겠습니다.');
    form.hidden = true; done.hidden = false;
    done.classList.remove('in'); requestAnimationFrame(() => requestAnimationFrame(() => done.classList.add('in')));
  });

  /* share */
  const cleanUrl = location.href.split('#')[0].replace(/[?&]open=1/, '').replace(/\?$/, '');
  $('#copyLink').addEventListener('click', () => copyText(cleanUrl, '링크가 복사되었어요'));
  $('#shareKakao').addEventListener('click', async () => {
    const data = { title: '변용철 · 최주현 결혼합니다', text: '2027년 3월 7일 일요일 오후 3시 · 오펠리스 라비제홀(20F)', url: cleanUrl };
    if (navigator.share){
      try { await navigator.share(data); return; } catch(e){ if (e && e.name === 'AbortError') return; }
    }
    copyText(cleanUrl, '링크를 복사했어요 · 카카오톡에 붙여넣어 주세요');
  });

  /* gallery: thumbnails + swipe lightbox */
  (function(){
    const gal = $('#gal'), lb = $('#lb'), track = $('#lbTrack'), cnt = $('#lbCount');
    const N = CONFIG.GALLERY.length;
    let idx = 0, lbOpen = false, lbLast = null, raf = 0;
    gal.innerHTML = CONFIG.GALLERY.map((src, i) =>
      '<button class="gt" type="button" data-i="' + i + '" aria-label="사진 ' + (i + 1) + ' 크게 보기">' +
      '<img src="' + src + '" alt="" loading="lazy" decoding="async"><span class="ph">' + String(i + 1).padStart(2, '0') + '</span></button>').join('');
    track.innerHTML = CONFIG.GALLERY.map((src, i) =>
      '<div class="lb-slide"><img src="' + src + '" alt="사진 ' + (i + 1) + '" loading="lazy" decoding="async" draggable="false"></div>').join('');
    /* show placeholders until real photos are uploaded */
    gal.querySelectorAll('img').forEach(img => {
      const ok = () => img.classList.add('ok');
      if (img.complete && img.naturalWidth) ok(); else img.addEventListener('load', ok);
    });
    track.querySelectorAll('img').forEach((img, i) => img.addEventListener('error', () => {
      const s = document.createElement('span'); s.className = 'ph'; s.textContent = 'Photo ' + String(i + 1).padStart(2, '0') + ' · 준비 중';
      img.replaceWith(s);
    }));
    const W = () => track.clientWidth || 1;
    function update(){ idx = Math.max(0, Math.min(N - 1, Math.round(track.scrollLeft / W()))); cnt.textContent = (idx + 1) + ' / ' + N; }
    function go(i){ track.scrollTo({ left: Math.max(0, Math.min(N - 1, i)) * W(), behavior: 'smooth' }); }
    function open(i){
      lbOpen = true; lbLast = document.activeElement; lockScroll();
      lb.classList.add('on'); lb.setAttribute('aria-hidden', 'false');
      track.style.scrollSnapType = 'none'; track.scrollLeft = i * W(); track.style.scrollSnapType = '';
      update(); at(60, () => $('#lbClose').focus({ preventScroll: true }));
    }
    function close(){
      if (!lbOpen) return; lbOpen = false;
      lb.classList.remove('on'); lb.setAttribute('aria-hidden', 'true');
      unlockScroll(); if (lbLast) lbLast.focus({ preventScroll: true });
    }
    gal.addEventListener('click', e => { const b = e.target.closest('.gt'); if (b) open(+b.dataset.i); });
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    $('#lbClose').addEventListener('click', close);
    $('#lbPrev').addEventListener('click', () => go(idx - 1));
    $('#lbNext').addEventListener('click', () => go(idx + 1));
    document.addEventListener('keydown', e => {
      if (!lbOpen) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') go(idx - 1);
      else if (e.key === 'ArrowRight') go(idx + 1);
    });
    window.addEventListener('resize', () => { if (lbOpen) track.scrollLeft = idx * W(); });
  })();

  /* naver map (loads only when the directions section is near) */
  (function(){
    if (!CONFIG.NAVER_MAP_KEY) return;
    const box = $('#nmap'), fb = $('#mapFallback'), note = $('#mapNote');
    const fallback = () => { box.hidden = true; fb.style.display = ''; note.style.display = ''; };
    window.navermap_authFailure = fallback;
    function load(){
      const s = document.createElement('script');
      s.src = 'https://oapi.map.naver.com/openapi/v3/maps.js?ncpKeyId=' + encodeURIComponent(CONFIG.NAVER_MAP_KEY) + '&submodules=geocoder';
      s.onerror = fallback;
      s.onload = () => {
        if (!window.naver || !naver.maps) return fallback();
        box.hidden = false; fb.style.display = 'none'; note.style.display = 'none';
        const pos = new naver.maps.LatLng(CONFIG.LAT, CONFIG.LNG);
        const map = new naver.maps.Map(box, {
          center: pos, zoom: 17,
          draggable: false, pinchZoom: false, scrollWheel: false, keyboardShortcuts: false,
          disableDoubleTapZoom: true, disableDoubleClickZoom: true,
          zoomControl: true, zoomControlOptions: { position: naver.maps.Position.TOP_RIGHT }
        });
        const marker = new naver.maps.Marker({ position: pos, map, icon: {
          content: '<div class="nm-pin"><svg viewBox="0 0 28 36"><path d="M14 35 C10 28 2 22 2 13 A12 12 0 1 1 26 13 C26 22 18 28 14 35Z" fill="#33402A"/><circle cx="14" cy="13" r="4.6" fill="#C2A66B"/></svg></div>',
          anchor: new naver.maps.Point(14, 35) } });
        if (naver.maps.Service && naver.maps.Service.geocode){
          naver.maps.Service.geocode({ query: CONFIG.ADDRESS }, (st, res) => {
            const a = st === naver.maps.Service.Status.OK && res.v2 && res.v2.addresses && res.v2.addresses[0];
            if (!a) return;
            const p = new naver.maps.LatLng(+a.y, +a.x);
            marker.setPosition(p); map.setCenter(p);
          });
        }
      };
      document.head.appendChild(s);
    }
    const io = new IntersectionObserver(es => { if (es.some(e => e.isIntersecting)){ io.disconnect(); load(); } }, { rootMargin: '600px 0px' });
    io.observe($('.directions'));
  })();

  /* music box (Web Audio, no files) */
  const MusicBox = (function(){
    let ctx, master, bus, timer, idx = 0, loopStart = 0, playing = false;
    const BEAT = 0.62, LOOP = 48, UP = 12;
    const mel = [
      [69,1],[72,1],[77,1], [76,1.5],[74,.5],[72,1], [74,1],[70,1],[67,1], [69,3],
      [65,1],[69,1],[72,1], [74,1.5],[72,.5],[70,1], [69,1],[67,1],[64,1], [65,3],
      [72,1],[74,.5],[76,.5],[77,1], [79,1.5],[77,.5],[76,1], [74,1],[72,1],[70,1], [69,2],[72,1],
      [70,1],[74,1],[79,1], [77,1.5],[76,.5],[74,1], [72,1],[69,1],[67,1], [65,3]
    ];
    const CH = { F:[53,60,65], C:[48,55,64], Gm:[55,58,62], Bb:[46,53,62], Dm:[50,57,62] };
    const prog = ['F','C','Gm','F','F','Bb','C','F','F','C','Bb','F','Gm','Dm','C','F'];
    const ev = [];
    let b = 0;
    mel.forEach(([m, d]) => { ev.push({ t: b, m: m + UP, v: .5 }); b += d; });
    prog.forEach((c, bar) => CH[c].forEach((m, i) => ev.push({ t: bar * 3 + i, m: m + UP, v: i ? .15 : .22 })));
    ev.sort((a, c) => a.t - c.t);

    function init(){
      ctx = new (window.AudioContext || window.webkitAudioContext)();
      master = ctx.createGain(); master.gain.value = 0;
      const comp = ctx.createDynamicsCompressor();
      master.connect(comp).connect(ctx.destination);
      bus = ctx.createGain(); bus.gain.value = 1;
      const len = Math.floor(ctx.sampleRate * 2.8), ir = ctx.createBuffer(2, len, ctx.sampleRate);
      for (let ch = 0; ch < 2; ch++){
        const data = ir.getChannelData(ch);
        for (let i = 0; i < len; i++) data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 3.2);
      }
      const verb = ctx.createConvolver(); verb.buffer = ir;
      const wet = ctx.createGain(); wet.gain.value = .32;
      bus.connect(master); bus.connect(verb).connect(wet).connect(master);
    }
    function tine(m, t, v){
      const f = 440 * Math.pow(2, (m - 69) / 12);
      [[1, v, 2.6], [2, v * .28, .9], [5.4, v * .1, .22]].forEach(([mul, g0, dec]) => {
        const o = ctx.createOscillator(), g = ctx.createGain();
        o.type = 'sine'; o.frequency.value = f * mul;
        g.gain.setValueAtTime(0, t);
        g.gain.linearRampToValueAtTime(g0, t + .004);
        g.gain.exponentialRampToValueAtTime(.0001, t + dec);
        o.connect(g).connect(bus);
        o.start(t); o.stop(t + dec + .05);
      });
    }
    function schedule(){
      while (true){
        const e = ev[idx], when = loopStart + e.t * BEAT + (Math.random() - .5) * .012;
        if (when > ctx.currentTime + .35) break;
        if (when >= ctx.currentTime - .02) tine(e.m, Math.max(when, ctx.currentTime), e.v);
        idx++;
        if (idx >= ev.length){ idx = 0; loopStart += (LOOP + 1) * BEAT; }
      }
    }
    return {
      toggle(){
        if (!ctx) init();
        if (!playing){
          ctx.resume();
          idx = 0; loopStart = ctx.currentTime + .15;
          master.gain.cancelScheduledValues(ctx.currentTime);
          master.gain.setValueAtTime(master.gain.value, ctx.currentTime);
          master.gain.linearRampToValueAtTime(.24, ctx.currentTime + 1.2);
          clearInterval(timer); timer = setInterval(schedule, 90); schedule();
          playing = true;
        } else {
          master.gain.cancelScheduledValues(ctx.currentTime);
          master.gain.setValueAtTime(master.gain.value, ctx.currentTime);
          master.gain.linearRampToValueAtTime(0, ctx.currentTime + .6);
          clearInterval(timer);
          playing = false;
          setTimeout(() => { if (!playing) ctx.suspend(); }, 2600);
        }
        return playing;
      }
    };
  })();
  const bgm = $('#bgm');
  bgm.addEventListener('click', () => {
    const on = MusicBox.toggle();
    bgm.setAttribute('aria-pressed', on);
    bgm.setAttribute('aria-label', on ? '배경음 끄기' : '배경음 켜기');
  });

  /* scroll reveal */
  function startReveal(){
    const io = new IntersectionObserver(es => es.forEach(e => {
      if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
    }), { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    $$('.reveal').forEach(s => io.observe(s));
  }

  /* drifting petals */
  function petals(){
    const layer = $('#petals');
    const lr = layer.getBoundingClientRect(), er = $('#envelope').getBoundingClientRect();
    const W = lr.width, H = lr.height;
    const ox = er.left - lr.left + er.width / 2, oy = er.top - lr.top + er.height * .08;
    const cols = [['#FAF4E6','#D8CBA8'], ['#CCD6B2','#9FAD82'], ['#E9D8A8','#BFA466']];
    for (let i = 0; i < 14; i++){
      const el = document.createElement('span');
      el.className = 'petal';
      const [fill, stroke] = cols[i % 3];
      const s = 10 + Math.random() * 9;
      el.style.width = s + 'px'; el.style.height = (s * 1.35) + 'px';
      el.style.marginLeft = (-s / 2) + 'px'; el.style.marginTop = (-s * .67) + 'px';
      el.innerHTML = '<svg viewBox="0 0 20 27"><path d="M10 1 C16 6 18 15 13.5 23 C12 25.6 8 25.6 6.5 23 C2 15 4 6 10 1Z" fill="' + fill + '" stroke="' + stroke + '" stroke-width=".6"/><path d="M10 4 C10.5 10 10.4 16 9.6 22" fill="none" stroke="' + stroke + '" stroke-width=".5" opacity=".7"/></svg>';
      layer.appendChild(el);
      const x0 = ox + (Math.random() - .5) * er.width * .55, y0 = oy;
      /* short-lived: lift out of the envelope, drift a little, settle and fade (~4s total) */
      const up = 60 + Math.random() * 120, dx = (Math.random() - .5) * W * .8;
      const fall = H * (.22 + Math.random() * .22);
      const dur = 2900 + Math.random() * 900, delay = Math.random() * 450;
      const r0 = Math.random() * 360, spin = (Math.random() < .5 ? -1 : 1) * (90 + Math.random() * 180);
      const sway = 12 + Math.random() * 18, ph = Math.random() * 6.28, N = 14, frames = [];
      for (let k = 0; k <= N; k++){
        const p = k / N; let x, y;
        if (p <= .22){ const q = p / .22, e = 1 - Math.pow(1 - q, 2); x = x0 + dx * .35 * e; y = y0 - up * e; }
        else { const q = (p - .22) / .78, e = 1 - Math.pow(1 - q, 1.8); x = x0 + dx * .35 + dx * .65 * e + Math.sin(ph + q * 6) * sway * (1 - q * .5); y = y0 - up + fall * e; }
        frames.push({
          transform: 'translate3d(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px,0) rotate(' + (r0 + spin * p).toFixed(1) + 'deg) rotateX(' + (Math.sin(ph + p * 9) * 55).toFixed(1) + 'deg) rotateY(' + (Math.cos(ph + p * 6) * 40).toFixed(1) + 'deg)',
          opacity: k === 0 ? 0 : p < .62 ? .95 : Math.max(0, .95 * (1 - (p - .62) / .38)),
          offset: p
        });
      }
      const anim = el.animate(frames, { duration: dur, delay, easing: 'linear', fill: 'both' });
      anim.onfinish = () => el.remove();
    }
    at(4600, () => { layer.innerHTML = ''; });
  }

  /* envelope sequence */
  const stage = $('#stage'), card = $('#card'), flap = $('#flap'), main = $('#main');
  let opened = false;

  function openEnvelope(){
    if (opened) return; opened = true;
    stage.classList.add('s1');                        // seal pops off and drops
    at(360,  () => stage.classList.add('s2'));        // flap folds back, liner shows
    at(620,  petals);
    at(880,  () => { flap.style.zIndex = 1; });       // flap passes 90° → behind card
    at(1400, () => stage.classList.add('s3'));        // card slides up with its face showing
    at(2750, expand);                                 // card grows into the cover
  }

  function expand(){
    const s = stage.getBoundingClientRect();
    const r = card.getBoundingClientRect();
    const core = $('#cardCore');
    const c0 = core.getBoundingClientRect();
    const t = $('#coverCore').getBoundingClientRect();

    stage.appendChild(card);
    card.classList.add('flying');
    Object.assign(card.style, { left: (r.left - s.left) + 'px', top: (r.top - s.top) + 'px', width: r.width + 'px', height: r.height + 'px' });

    stage.appendChild(core);
    core.classList.add('flying-core');
    Object.assign(core.style, { left: (c0.left - s.left) + 'px', top: (c0.top - s.top) + 'px', width: c0.width + 'px', transform: 'none' });

    card.getBoundingClientRect();
    card.classList.add('grow');
    core.classList.add('go');
    Object.assign(card.style, { left: '0px', top: '0px', width: s.width + 'px', height: s.height + 'px' });
    const k = t.width / c0.width;
    core.style.transform = 'translate(' + (t.left - c0.left) + 'px,' + (t.top - c0.top) + 'px) scale(' + k + ')';
    stage.classList.add('s5');

    at(1200, () => {
      main.classList.add('show');
      document.documentElement.classList.remove('locked');
      window.scrollTo(0, 0);
      $('#cover').classList.add('in');
      stage.classList.add('done');
      bgm.classList.add('show');
      startReveal();
      at(700, () => stage.remove());
    });
  }

  stage.addEventListener('click', openEnvelope);
  $('#envelope').addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); openEnvelope(); }
  });

  /* intro entrance (after fonts) */
  let readied = false;
  function ready(){
    if (readied) return; readied = true;
    requestAnimationFrame(() => stage.classList.add('ready'));
    if (new URLSearchParams(location.search).get('open') === '1') at(1300, openEnvelope);
  }
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(ready);
  setTimeout(ready, 1500);
})();
</script>
</body>
